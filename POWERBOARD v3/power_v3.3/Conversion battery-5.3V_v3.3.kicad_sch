	)
	(text_box "BUCK: TPS62160DSG\nVIN: SYS (3V-17V, ~7.2-8.4V from battery)\nVOUT: 5.3V (R4=1.02M,R5=180k,VOUT=0.8V*(1+R4/R5))\nImax: 1A (Ilim 1.45-2.45A typ 1.95A)\nfSW: 2.25MHz\nL/COUT: 2.2uH / 22uF (LC combo recommended)\nCIN: 10uF\nEN: tied to VIN (always on)\nPG: tied to GND (unused)\nVPS: Kelvin direct to VOUT (control loop)"
		(exclude_from_sim no)
		(at 173.99 129.2754 0)
		(size 58.42 22.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
