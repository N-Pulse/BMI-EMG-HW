			)
			(justify left top)
		)
		(uuid "31168909-10f9-44ff-be8f-b73721645020")
	)
	(text_box "BATTERY CONNECTION\n"
		(exclude_from_sim no)
		(at 27.94 91.44 0)
		(size 97.79 25.908)
		(margins 0.9525 0.9525 0.9525 0.9525)
