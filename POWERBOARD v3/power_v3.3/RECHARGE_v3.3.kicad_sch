		(uuid "93ec7fb5-a965-459f-a4b3-4a37e517cd92")
	)
	(text_box "R1 selected to give max charging current of 1.7A (nominal value recommended by the battery datasheet, can go up to 3.4A)\nVSET sets the charging voltage (8.4V). A >150kOhm value is recommended for R2. The pin can also be left floating.\nR9 has the value recommended by the datasheet.\nR4 = 383Ohm -> IIN max = 2.9A"
		(exclude_from_sim no)
		(at 67.31 68.58 0)
		(size 48.26 20.3201)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2c3d501c-604c-4e55-8016-06f40bfba605")
	)
	(text_box "This bloc is the external connection of the battery to the board. We use a Molex Pico-Lock connector to give the user the opportunity to plug and unplug the battery."
		(exclude_from_sim no)
		(at 88.9 103.1766 0)
		(size 36.83 14.1714)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
