			)
			(justify left top)
		)
		(uuid "721cd03c-e0c9-4b89-9db6-290117bba8d5")
	)
	(text_box "Handles the charging of the battery and power management of the system. To understand the function of each pin, please refer to the documentation, as most of the connections, resistor and capacitance value selection has been done by following the requirements/recommendations of the datasheet."
		(exclude_from_sim no)
		(at 240.284 135.3462 0)
		(size 27.686 28.4838)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 92 0 255 0.168627451)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9ac59d2f-fb11-41a8-a2a6-7a65f3d01b28")
	)
	(text_box "CHARGING IC"
		(exclude_from_sim no)
		(at 153.162 88.9 0)
		(size 114.808 74.93)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9eedbe52-46c9-4065-816c-1cfb5c385cb4")
	)
	(text_box "NTC is placed on the battery cells. The BMS integrated in our battery only handles the electric protection (charge, discharge) and not the temperature. Via TS, the IC progressively adjusts the charging profile according to the temperature to preserve the battery. Its value at 25°C should be of 10kOhm."
		(exclude_from_sim no)
		(at 184.15 68.5947 0)
		(size 38.1 20.3053)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c6e3b142-60a9-4877-a1b1-fac0922d59c3")
	)
	(text_box "USB-C CONNECTOR\n"
		(exclude_from_sim no)
		(at 27.94 119.126 0)
		(size 97.79 73.914)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c8af01fa-6292-4fd6-9acc-319a4d8825fd")
	)
	(text_box "The USB connector we use has to be compatible with the IC used to manage the battery. This is why we chose a USB-C 2.0 connector. The wiring is done to turn it into a \"dumb\" charger, providing the IC with the information of how much current and voltage it can pull, charging the battery and powering the system if a cable is connected, ignoring most of its data transfer abilities."
		(exclude_from_sim no)
		(at 87.63 166.5861 0)
		(size 38.1 26.4392)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 92 0 255 0.168627451)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d425b8e8-f8b9-4d84-b1ad-bbbe188df713")
	)
	(text_box "L1: power inductor\nIRIPPLE = VBUS × (VSYS − VBUS) / (VSYS × fSW × L) = 1.35A \nVBUS = 5V, VSYS = 8.4V, fSW = 1.5MHz, L=1µH\nISAT > IIN(max) + IRIPPLE/2 = 3.58A"
		(exclude_from_sim no)
		(at 27.94 72.6839 0)
		(size 38.1 16.2161)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ef3d39b3-2a4c-4978-aeae-8b9e36932fd6")
	)
