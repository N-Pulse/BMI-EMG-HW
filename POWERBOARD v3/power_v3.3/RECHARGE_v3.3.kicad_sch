		(uuid "3e3871e3-5c50-44b5-88bf-165b8a569554")
	)
	(text_box "Sets the different values necessary for the proper function of the IC. Sets the charging values of the battery."
		(exclude_from_sim no)
		(at 238.76 76.7732 0)
		(size 29.21 12.1268)
		(margins 0.9525 0.9525 0.9525 0.9525)
