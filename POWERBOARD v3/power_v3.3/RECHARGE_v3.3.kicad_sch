		(uuid "4cd332ba-a756-4d6c-b668-de44ca35fa79")
	)
	(text_box "CHARGING IC - SETUP\n"
		(exclude_from_sim no)
		(at 27.94 21.59 0)
		(size 240.03 67.31)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
