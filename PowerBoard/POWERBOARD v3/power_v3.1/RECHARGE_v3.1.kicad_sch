	)
	(text_box "R1 selected to give max charging current of ~1A (nominal value recommended by the battery datasheet, can go up to 2A)\nVSET sets the charging voltage (8.4V). A >150kOhm value is recommended for R2. The pin can also be left floating.\nR9 has the value recommended by the datasheet.\nR9 = 383Ohm -> IIN max = 2.9A"
		(exclude_from_sim no)
		(at 67.31 68.58 0)
		(size 48.26 20.3201)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2c3d501c-604c-4e55-8016-06f40bfba605")
	)
	(text_box "TEMPERATURE SENSING - Safety switch off"
		(exclude_from_sim no)
		(at 21.59 88.9 0)
		(size 149.86 35.56)
