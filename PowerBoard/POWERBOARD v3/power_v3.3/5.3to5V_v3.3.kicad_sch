	)
	(text_box "Output is high when the temperature is low enough, is low when the temperature reaches 58.4°C, disconnecting the load. The rest of the powerboard is still on.\nWhen the temperature reaches 50.5°C again, it goes back to high."
		(exclude_from_sim no)
		(at 242.824 143.2707 0)
		(size 34.036 20.3053)
		(margins 0.9525 0.9525 0.9525 0.9525)
